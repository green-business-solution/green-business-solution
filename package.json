{
  "name": "green-business-solution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "node server/index.mjs",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "gather:dsire": "node scripts/gather-dsire-opportunities.mjs",
    "gather:dsire:public": "node scripts/gather-dsire-opportunities.mjs --mode public-table",
    "gather:dsire:rss": "node scripts/gather-dsire-opportunities.mjs --mode rss",
    "gather:dsire:aws": "node scripts/gather-dsire-opportunities.mjs --mode public-table --public-category financial --write-dynamodb",
    "gather:dsire:aws:rss": "node scripts/gather-dsire-opportunities.mjs --mode rss --write-dynamodb",
    "matching:facility-reviews": "node scripts/research-facility-eligibility.mjs",
    "matching:facility-reviews:write": "node scripts/write-facility-eligibility-reviews.mjs",
    "matching:utility-reviews": "node scripts/research-utility-restrictions.mjs",
    "matching:utility-reviews:write": "node scripts/write-utility-restriction-reviews.mjs",
    "matching:availability-reviews": "node scripts/research-availability.mjs",
    "matching:availability-reviews:write": "node scripts/write-availability-reviews.mjs",
    "matching:availability-reviews:public": "OPPORTUNITY_SOURCE_PATH=public/retrofit_opportunity_index.json AVAILABILITY_REVIEW_OUTPUT_PATH=data/public_opportunity_availability_reviews.json AVAILABILITY_REVIEW_REPORT_PATH=data/public_opportunity_availability_review_report.md node scripts/research-availability.mjs",
    "matching:availability-reviews:public:uncertain": "OPPORTUNITY_SOURCE_PATH=public/retrofit_opportunity_index.json AVAILABILITY_REVIEW_OUTPUT_PATH=data/public_opportunity_availability_reviews.json AVAILABILITY_REVIEW_REPORT_PATH=data/public_opportunity_availability_review_report.md node scripts/research-uncertain-availability.mjs",
    "matching:availability-research-prompt": "node scripts/write-availability-research-prompt.mjs",
    "matching:availability-apply-repairs": "node scripts/apply-availability-research-repairs.mjs",
    "matching:availability-public-fixtures": "node scripts/apply-availability-reviews-to-public-fixtures.mjs",
    "matching:special-edge-audit": "node scripts/audit-special-retrofit-edges.mjs",
    "matching:special-edge-suppressions:public": "node scripts/apply-special-edge-suppressions-to-public-fixtures.mjs",
    "matching:archive-unavailable": "node scripts/archive-unavailable-opportunities.mjs",
    "matching:review-repairs": "node scripts/apply-targeted-review-repairs.mjs",
    "matching:status-bucket-repairs": "node scripts/apply-status-bucket-cleanup-repairs.mjs",
    "matching:opportunity-data-repairs": "node scripts/apply-opportunity-data-research-repairs.mjs",
    "matching:opportunity-data-repairs:apply-all": "node scripts/apply-all-opportunity-data-research-repairs.mjs",
    "matching:opportunity-data-repairs:intake": "node scripts/intake-opportunity-data-research-repairs.mjs",
    "matching:opportunity-data-repairs:validate": "node scripts/validate-opportunity-data-research-repairs.mjs",
    "matching:opportunity-data-work-packet": "node scripts/write-opportunity-data-gpt-pro-work-packet.mjs",
    "matching:opportunity-data-targets": "node scripts/write-opportunity-data-research-targets.mjs",
    "matching:low-source-confidence-queue": "node scripts/write-low-source-confidence-opportunity-queue.mjs",
    "matching:sample": "node scripts/run-sample-matching.mjs",
    "matching:sample-opportunity-audit": "node scripts/audit-sample-matching-opportunity-data.mjs",
    "matching:test-case-utility-prompt": "node scripts/write-sample-test-case-utility-data-prompt.mjs",
    "matching:test-case-utility-data": "node scripts/import-sample-test-case-utility-data.mjs",
    "matching:promote-test-users": "node scripts/promote-sample-test-cases-to-fake-users.mjs",
    "matching:test-case-savings": "node scripts/patch-admin-test-case-savings.mjs",
    "matching:incentive-formula-work-packet": "node scripts/write-incentive-formula-rate-table-work-packet.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1073.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/credential-providers": "^3.1073.0",
    "@aws-sdk/lib-dynamodb": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.3",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.9.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serverless-http": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vitest": "^3.0.0"
  }
}
