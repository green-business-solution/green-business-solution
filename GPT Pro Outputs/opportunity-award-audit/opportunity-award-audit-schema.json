{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://green-business-solution.local/schemas/opportunity-award-audit-output.schema.json",
  "title": "OpportunityAwardAuditOutput",
  "type": "object",
  "required": [
    "schemaVersion",
    "batchId",
    "inputFile",
    "inputRecordCount",
    "generatedAt",
    "reviews"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "opportunity-award-audit-output.v1"
    },
    "batchId": {
      "type": "string",
      "pattern": "^batch-\\d{3}$"
    },
    "inputFile": {
      "type": "string"
    },
    "inputRecordCount": {
      "type": "integer",
      "minimum": 0
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewRecord"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "reviewRecord": {
      "type": "object",
      "required": [
        "opportunityId",
        "requiresProgramApproval",
        "approvalRequirements",
        "approvalStage",
        "awardLikelihood",
        "awardLikelihoodReason",
        "evidenceUrls",
        "evidenceText",
        "reviewedAt",
        "reviewStatus"
      ],
      "properties": {
        "opportunityId": {
          "type": "string",
          "minLength": 1
        },
        "requiresProgramApproval": {
          "type": "boolean"
        },
        "approvalRequirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approvalStage": {
          "type": "string",
          "enum": [
            "pre-application",
            "application",
            "under-review",
            "document-review",
            "award-review",
            "disbursal",
            "unknown"
          ]
        },
        "awardLikelihood": {
          "type": "string",
          "enum": ["near_guaranteed", "likely", "possible", "unlikely", "rare", "unknown"]
        },
        "awardLikelihoodReason": {
          "type": "string",
          "minLength": 1
        },
        "evidenceUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://"
          }
        },
        "evidenceText": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewStatus": {
          "type": "string",
          "enum": ["audited", "source_inaccessible", "not_audited", "needs_followup", "needs_evidence"]
        }
      },
      "additionalProperties": false
    }
  }
}

