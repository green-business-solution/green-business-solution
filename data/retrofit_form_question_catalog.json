  "bindings": [
    {
      "bindingId": "lighting",
      "priority": 10,
      "match": {
        "retrofitTypeIdContains": [
          "lighting",
          "led"
        ]
      },
      "questionIds": [
        "lighting_fixture_count",
        "lighting_existing_type",
        "lighting_operating_hours",
        "lighting_controls",
        "project_quote_status"
      ]
    },
    {
      "bindingId": "hvac",
      "priority": 20,
      "match": {
        "retrofitTypeIdContains": [
          "hvac"
        ]
      },
      "questionIds": [
        "current_hvac_system",
        "current_fuel_type",
        "equipment_age",
        "ductwork_replacement_needed",
        "project_quote_status"
      ]
    },
    {
      "bindingId": "insulation_envelope",
      "priority": 30,
      "match": {
        "retrofitTypeIdContains": [
