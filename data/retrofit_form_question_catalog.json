        "charger_count",
        "charger_level",
        "charger_use_case",
        "panel_capacity_known",
        "expected_utilization",
        "fuel_baseline"
      ]
    },
    {
      "bindingId": "biomass_biogas",
      "priority": 60,
      "match": {
        "retrofitTypeIdContains": [
          "biomass",
          "biogas"
        ]
      },
      "questionIds": [
        "biomass_fuel_stream",
        "feedstock_quantity",
        "biomass_use_case",
        "vendor_quote_status",
        "permits_or_interconnection_known"
      ]
    },
    {
      "bindingId": "solar",
      "priority": 70,
      "match": {
        "retrofitTypeIdContains": [
          "solar"
        ]
      },
      "questionIds": [
        "solar_roof_area",
        "solar_roof_control",
        "solar_roof_condition",
        "solar_system_size",
        "project_quote_status",
        "annual_kwh_usage"
      ]
    },
    {
      "bindingId": "water",
      "priority": 80,
      "match": {
        "retrofitTypeIdContains": [
          "water"
        ]
      },
      "questionIds": [
        "water_fixture_scope",
        "monthly_water_bill",
        "water_fixture_count",
        "project_quote_status"
      ]
    },
    {
      "bindingId": "default",
      "priority": 1000,
      "match": {
        "always": true
      },
      "questionIds": [
        "generic_quantity_scope",
        "generic_current_equipment",
        "generic_usage_frequency",
