{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenbusinesssolution.org/schemas/operational-savings/source-fixture-v1.json",
  "title": "Operational Savings Reviewed Source Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_type",
    "fixture_schema_version",
    "reviewed_on",
    "retrieved_on",
    "source_title",
    "source_urls",
    "raw_artifacts",
    "coverage",
    "fields",
    "tables",
    "values",
    "methods",
    "supported_uses",
    "unsupported_inferences",
    "provenance_notes"
  ],
  "properties": {
    "fixture_type": {
      "const": "reviewed_source_fixture"
    },
    "fixture_schema_version": {
      "const": "1.0.0"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "retrieved_on": {
      "type": "string",
      "format": "date"
    },
    "source_title": {
      "type": "string",
      "minLength": 1
    },
    "source_urls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "raw_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_identifier",
          "source_url",
          "source_version",
          "exact_artifact",
          "source_checksum"
        ],
        "properties": {
          "artifact_identifier": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "exact_artifact": {
            "type": "string",
            "minLength": 1
          },
          "source_checksum": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "source_roles",
        "scenarios"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fields": {
      "$ref": "#/$defs/substantiveRecords"
    },
    "tables": {
      "$ref": "#/$defs/substantiveRecords"
    },
    "values": {
      "$ref": "#/$defs/substantiveRecords"
    },
    "methods": {
      "$ref": "#/$defs/substantiveRecords"
    },
    "supported_uses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unsupported_inferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "fields": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "tables": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "values": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "methods": {
              "minItems": 1
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "substantiveRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "unit_id",
          "role",
          "source_location"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "source_location": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
