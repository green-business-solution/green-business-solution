{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenbusinesssolution.org/schemas/operational-savings/information-card-v1.json",
  "title": "Operational Savings Information Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "categoryId",
    "title",
    "retrofitNames",
    "overview",
    "broaderFormula",
    "expandedFormula",
    "tree",
    "processes"
  ],
  "properties": {
    "categoryId": {
      "type": "string",
      "pattern": "^ITC-[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "retrofitNames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "overview": {
      "type": "string",
      "minLength": 1
    },
    "broaderFormula": {
      "type": "string",
      "minLength": 1
    },
    "expandedFormula": {
      "type": "string",
      "minLength": 1
    },
    "tree": {
      "$ref": "#/$defs/treeNode"
    },
    "processes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/process"
      }
    }
  },
  "$defs": {
    "treeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "children"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/treeNode"
          }
        },
        "processKey": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "displayNumber",
        "name",
        "canonicalStandardIds",
        "sourceName",
        "purpose",
        "lookupInputs",
        "valueNeeded",
        "howToUse",
        "automation",
        "validation",
        "evidenceState",
        "inputBindings",
        "outputBindings",
        "selectionPolicy"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "displayNumber": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "canonicalStandardIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^STD-[A-Z0-9-]+$"
          }
        },
        "sourceName": {
          "type": "string",
          "minLength": 1
        },
        "sourceLinkLabels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "lookupInputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "valueNeeded": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "howToUse": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "automation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selectedStrategy",
            "automationMethod",
            "difficulty"
          ],
          "properties": {
            "selectedStrategy": {
              "type": "string",
              "minLength": 1
            },
            "automationMethod": {
              "type": "string",
              "minLength": 1
            },
            "difficulty": {
              "enum": [
                "Easy",
                "Easy to Medium",
                "Medium",
                "Medium to Hard",
                "Hard"
              ]
            }
          }
        },
        "validation": {
          "type": "string",
          "minLength": 1
        },
        "evidenceState": {
          "enum": [
            "EXECUTABLE_PROOF_PRESENT",
            "METHOD_VERIFIED_IMPLEMENTATION_PENDING",
            "SOURCE_UNSUPPORTED"
          ]
        },
        "inputBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lookupInput",
              "treePath",
              "sourceLabel",
              "use"
            ],
            "properties": {
              "lookupInput": {
                "type": "string",
                "minLength": 1
              },
              "treePath": {
                "type": "string",
                "minLength": 1
              },
              "sourceLabel": {
                "enum": [
                  "User",
                  "Profile",
                  "Bill",
                  "Linked Opportunity",
                  "Project Document",
                  "Derived",
                  "Standard Output"
                ]
              },
              "use": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "outputBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outputName",
              "treePath",
              "formulaTerm",
              "outputUnit",
              "outputScope"
            ],
            "properties": {
              "outputName": {
                "type": "string",
                "minLength": 1
              },
              "treePath": {
                "type": "string",
                "minLength": 1
              },
              "formulaTerm": {
                "type": "string",
                "minLength": 1
              },
              "outputUnit": {
                "type": "string",
                "minLength": 1
              },
              "outputScope": {
                "enum": [
                  "PER_FIXTURE",
                  "PER_EQUIPMENT_UNIT",
                  "PER_PORT",
                  "PER_EVENT",
                  "PER_HOUR",
                  "PER_YEAR",
                  "SITE_TOTAL",
                  "PROJECT_TOTAL",
                  "PROFILE",
                  "RECORD_SET"
                ]
              }
            }
          }
        },
        "selectionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outputCardinality",
            "fallbackOrder",
            "multipleRecordRule",
            "selectedValueMethod",
            "missingExactValueBehavior",
            "retainedMetadata"
          ],
          "properties": {
            "outputCardinality": {
              "enum": [
                "ONE_SELECTED_SCALAR",
                "ONE_SELECTED_RECORD",
                "ONE_SELECTED_PROFILE",
                "ONE_SELECTED_INPUT_SET",
                "ONE_SELECTED_RESULT_SET"
              ]
            },
            "fallbackOrder": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "prefixItems": [
                {
                  "const": "EXACT_MEASURED_OR_DOCUMENTED"
                },
                {
                  "const": "EXACT_PRODUCT_OR_PROJECT_SPECIFICATION"
                },
                {
                  "const": "EXACT_AUTHORITATIVE_DATABASE_LOOKUP"
                },
                {
                  "const": "CONTEXT_MATCHED_AUTHORITATIVE_BENCHMARK"
                },
                {
                  "const": "DETERMINISTIC_RETROFI_BENCHMARK"
                }
              ]
            },
            "multipleRecordRule": {
              "enum": [
                "OFFICIAL_RECOMMENDED_OR_TYPICAL_THEN_WEIGHTED_MEDIAN_THEN_MEDIAN",
                "NOT_APPLICABLE_DETERMINISTIC_SELECTION"
              ]
            },
            "selectedValueMethod": {
              "type": "string",
              "minLength": 1
            },
            "missingExactValueBehavior": {
              "type": "string",
              "minLength": 1
            },
            "retainedMetadata": {
              "type": "array",
              "minItems": 10,
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "selected_value",
                  "unit",
                  "source",
                  "source_version",
                  "context_filters",
                  "eligible_population",
                  "population_size",
                  "selection_rule",
                  "fallback_level",
                  "value_provenance"
                ]
              }
            }
          }
        }
      }
    }
  }
}
