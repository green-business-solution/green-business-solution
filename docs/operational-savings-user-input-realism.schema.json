{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenbusinesssolution.org/schemas/operational-savings/user-input-realism-v1.json",
  "title": "Operational Savings Visible User Input Realism Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_from",
    "user_leaf_count",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "const": "operational-savings/user-input-realism-v1"
    },
    "generated_from": {
      "const": "operational-savings Information Card presentation trees"
    },
    "user_leaf_count": {
      "type": "integer",
      "minimum": 0
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/userInput"
      }
    }
  },
  "$defs": {
    "userInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category_id",
        "tree_path",
        "visible_label",
        "knowledge_likelihood",
        "recognizable_to_ordinary_user",
        "reason_the_user_would_have_it",
        "value_importance",
        "alternate_source",
        "missing_value_behavior"
      ],
      "properties": {
        "category_id": {
          "type": "string",
          "pattern": "^ITC-[0-9]{2}$"
        },
        "tree_path": {
          "type": "string",
          "minLength": 1
        },
        "visible_label": {
          "type": "string",
          "minLength": 1
        },
        "knowledge_likelihood": {
          "enum": [
            "LIKELY_KNOWN",
            "MAY_KNOW",
            "UNLIKELY_KNOWN"
          ]
        },
        "recognizable_to_ordinary_user": {
          "type": "boolean"
        },
        "reason_the_user_would_have_it": {
          "type": "string",
          "minLength": 1
        },
        "value_importance": {
          "enum": [
            "LOW",
            "MODERATE",
            "HIGH"
          ]
        },
        "alternate_source": {
          "enum": [
            "PROFILE",
            "BILL",
            "LINKED_OPPORTUNITY",
            "STANDARD",
            "PROJECT_DOCUMENT",
            "CONTRACTOR_SPECIFICATION",
            "NONE"
          ]
        },
        "connected_process_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "missing_value_behavior": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
