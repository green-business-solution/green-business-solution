{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenbusinesssolution.org/schemas/operational-savings/user-input-realism-v2.json",
  "title": "Operational Savings Visible User Input Realism Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_from",
    "user_leaf_count",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "const": "operational-savings/user-input-realism-v2"
    },
    "generated_from": {
      "const": "operational-savings Information Card presentation trees"
    },
    "user_leaf_count": {
      "type": "integer",
      "minimum": 0
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/userInput"
      }
    }
  },
  "$defs": {
    "userInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category_id",
        "tree_path",
        "visible_label",
        "decision",
        "reason",
        "fallback_process_key",
        "selected_value_method",
        "missing_exact_value_behavior"
      ],
      "properties": {
        "category_id": {
          "type": "string",
          "pattern": "^ITC-[0-9]{2}$"
        },
        "tree_path": {
          "type": "string",
          "minLength": 1
        },
        "visible_label": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "USER_MEMORY",
            "USER_RECOGNIZABLE_ACTIVITY",
            "PROFILE",
            "BILL",
            "LINKED_OPPORTUNITY",
            "PROJECT_DOCUMENT",
            "STANDARD_BENCHMARK"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "fallback_process_key": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "selected_value_method": {
          "type": "string",
          "minLength": 1
        },
        "missing_exact_value_behavior": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
